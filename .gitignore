# Dart / Flutter analyzer + formatter caches
.analyzer/
.dcm/

# Pub global / tooling
.pub-cache/hosted/pub.dev/*

# Compiled assets that should be regenerated
**/doc/api/
migrate_working_dir/
.build/
.buildlog/
.svn/
.swiftpm/

# ----------------------------------------------------------------------------
# Explicitly KEEP (do not ignore) — documented so future edits don't break this
# ----------------------------------------------------------------------------
# !pubspec.lock          (tracked: reproducible app builds)
# !lib/**/*.g.dart       (tracked: Drift codegen)
# !lib/**/*.drift.dart   (tracked: Drift codegen)
# !assets/fonts/         (tracked: bundled Inter font per design spec)
# !android/gradle/wrapper/gradle-wrapper.properties
# !ios/Podfile.lock      (tracked: reproducible iOS builds)
# !.env.example          (tracked: documents required env keys without secrets)

# ----------------------------------------------------------------------------
# Secrets, env, and local config — NEVER commit (PRD §11 privacy)
# ----------------------------------------------------------------------------
.env
.env.*
*.env
!.env.example
!.env.sample
secrets.dart
**/secrets.dart
**/google-services.json.bak
**/GoogleService-Info.plist.bak
key.properties.bak
*.secret
*.token

# Platform secure-storage / debug helpers
*.keychain
*.keychain-db

# ----------------------------------------------------------------------------
# Local financial data — NEVER commit real user data (PRD §11)
# Backups (*.json), CSV exports, and SQLite DBs may contain sensitive records.
# ----------------------------------------------------------------------------
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-shm
*.sqlite-wal
*.realm
*.realm.lock
*.realm.note
*.hive
*.hive.lock
*.box

# Backup / export artifacts produced by the app or tests
/backups/
/exports/
/backups*/
/exports*/
*.backup
*.bak
saldo_backup*.json
saldo_export*.csv
export_*.csv

# Test fixtures that contain realistic PII — keep synthetic fixtures tracked
# under test/fixtures/, ignore ad-hoc local dumps:
*.dump.json
test/*.db
test/**/*.db
integration_test/screenshots/
integration_test/test_output/

# Temporary files the app may leave in repo-adjacent folders
*.tmp
*.temp
*.swp
*.swo
*~

# ----------------------------------------------------------------------------

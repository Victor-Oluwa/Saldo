# ============================================================================
# Saldo — production .gitignore
# Flutter (Android-first, offline) + Drift/SQLite + Riverpod + GoRouter
# ----------------------------------------------------------------------------
# Principles:
#  1. Never commit local financial data (DBs, backups, CSV exports).
#  2. Never commit signing keys, keystores, or secrets (.env, key.properties).
#  3. Track pubspec.lock for an app (reproducible builds); ignore build output.
#  4. Track Drift generated *.g.dart / *.drift.dart (required to build without
#     running build_runner) — do NOT ignore them.
# ============================================================================

# ----------------------------------------------------------------------------
# Dart / Flutter / Pub
# ----------------------------------------------------------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub/
.pub-cache/
.pubspec.lock.bak
.packages
package_config.json
version.json

# Build outputs (all platforms)
/build/
**/build/

# Test coverage + profiling
/coverage/
coverage/
.lcov/
*.lcov
lcov.info

# Dartdoc output
**/doc/api/
**/doc/_api/

# Flutter tool state
**/ios/Flutter/.last_build_id
**/ios/Flutter/Flutter.podspec
.flutter_version
.fvm/
flutter_*.log

# Build_runner / codegen cache (generated sources themselves ARE tracked)
.dart_tool/build/
.dart_tool/dartdoc/
.dart_tool/flutter_build/
.dart_tool/pub/
generated/
*.g.part
*.freezed.part

# Symbolication + obfuscation maps (re-generated on every release build)
app.*.symbols
app.*.map.json

# ----------------------------------------------------------------------------
# Android (Gradle + signing + local SDK config)
# ----------------------------------------------------------------------------
# Local SDK path — machine-specific, never commit
local.properties
android/local.properties

# Gradle caches (Flutter's android/.gitignore already covers gradlew, the
# wrapper jar, and local.properties; the flutter tool regenerates them)
.gradle/
android/.gradle/
android/captures/

# Build outputs
/android/app/debug
/android/app/profile
/android/app/release
/android/app/build/
android/app/*.apk
android/app/*.aab
android/app/*.apks
**/*.apk
**/*.aab
**/*.apks
**/*.dex
**/*.class

# Signing — NEVER commit real keys
*.keystore
*.jks
*.key
android/key.properties
android/app/key.properties
**/release.keystore
**/upload-key.keystore
**/debug.keystore.bak

# Firebase / Play config (contains project identifiers; keep out of public repos)
# Uncomment if this project must stay fully private/offline per PRD §11:
# android/app/google-services.json
# android/app/google-services*.json

# Fastlane supply / Play metadata (often contains release notes + screenshots)
android/fastlane/report.xml
android/fastlane/Preview.html
android/fastlane/screenshots/**/*
android/fastlane/test_output/**/*

# ----------------------------------------------------------------------------
# iOS / macOS (Xcode + CocoaPods) — kept portable per PRD §12
# ----------------------------------------------------------------------------
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework/
ios/Flutter/Flutter.podspec
ios/Flutter/App.framework/
ios/Flutter/FlutterPluginRegistrant/
ios/Runner/GeneratedPluginRegistrant.*
ios/Runner.xcworkspace/xcuserdata/
ios/*.xcworkspace/xcuserdata/
**/xcuserdata/
**/DerivedData/
**/*.xcuserstate
**/*.xccheckout
**/*.moved-aside
**/*.pbxuser
**/*.perspectivev3
**/*.mode1v3
**/*.mode2v3
*.hmap
*.ipa
*.dSYM.zip
*.dSYM
macos/Pods/
macos/Flutter/GeneratedPluginRegistrant.*
macos/Flutter/ephemeral/
macos/**/DerivedData/

# Provisioning / certs — NEVER commit
*.mobileprovision
*.provisionprofile
*.p12
*.cer
*.pem
ios/Runner/*.mobileprovision

# CocoaPods (Pods/ ignored above; keep Podfile + Podfile.lock tracked)
# Pods/CrashlyticsReport/
Pods/

# ----------------------------------------------------------------------------
# Linux / Windows / Web desktops
# ----------------------------------------------------------------------------
linux/flutter/ephemeral/
linux/flutter/generated_plugin_registrant.*
linux/build/
windows/flutter/ephemeral/
windows/flutter/generated_plugin_registrant.*
